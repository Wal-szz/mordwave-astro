---
import { nav, site, waLink } from '../data/site';
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="cols">
      <div class="about">
        <p class="mono k">MordWave</p>
        <p>Estudio de diseño y desarrollo web. Landing pages y webs con reservas para negocios que quieren crecer en digital.</p>
      </div>
      <div>
        <p class="mono k">Índice</p>
        <ol>{nav.map((n, i) => <li><a class="ulink" href={n.href}><span class="mono">{String(i + 1).padStart(2, '0')}</span>{n.label}</a></li>)}</ol>
      </div>
      <div>
        <p class="mono k">Contacto</p>
        <ul>
          <li><a class="ulink" href={waLink()} target="_blank" rel="noopener">WhatsApp ↗</a></li>
          <li><a class="ulink" href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener">Instagram ↗</a></li>
          <li><a class="ulink" href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
      <div>
        <p class="mono k">Hora en Chillán</p>
        <p class="clock" data-clock>--:--</p>
        <a class="mono top ulink" href="#inicio">Volver arriba ↑</a>
      </div>
    </div>

    <!-- Marca grande: SVG que siempre calza con el ancho disponible -->
    <svg class="wordmark" viewBox="0 0 1000 180" role="img" aria-label="MordWave">
      <text x="500" y="152" text-anchor="middle" textLength="996" lengthAdjust="spacingAndGlyphs">MordWave</text>
    </svg>

    <div class="bottom mono">
      <span>© {year} MordWave</span>
      <span>Hecho en Chillán, Chile</span>
      <span>Todos los derechos reservados</span>
    </div>
  </div>
</footer>

<a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-1 1.2-.4.2-.7.1a8.2 8.2 0 0 1-4.1-3.6c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.4 3.4 0 0 0-1 2.5 5.9 5.9 0 0 0 1.2 3.1 13.5 13.5 0 0 0 5.2 4.6c1.9.8 2.7.9 3.6.7a3.1 3.1 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.2-.3-.3-.6-.4ZM12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8Zm8.4-18.2A11.8 11.8 0 0 0 1.8 17.8L.1 24l6.4-1.7A11.8 11.8 0 0 0 12 23.7 11.8 11.8 0 0 0 20.4 3.6Z"/></svg>
</a>

<style>
  footer { background: var(--ink); color: var(--paper); padding: 0 0 96px; }
  .cols { display: grid; grid-template-columns: 2fr 1.4fr 1.4fr 1fr; gap: 32px; padding: 48px 0; border-top: 1px solid rgba(244, 241, 251, .2); }
  .k { color: rgba(244, 241, 251, .5); margin-bottom: 14px; }
  .about p:not(.k) { color: rgba(244, 241, 251, .75); max-width: 36ch; font-size: 15px; }
  ol, ul { list-style: none; display: grid; gap: 8px; font-size: 15px; }
  ol a { display: inline-flex; gap: 10px; align-items: baseline; }
  ol .mono { font-size: 10px; color: rgba(244, 241, 251, .45); }
  .clock { font-family: var(--serif); font-style: italic; font-size: 44px; line-height: 1; margin-bottom: 14px; }
  .top { color: var(--violet-soft); }

  .wordmark { display: block; width: 100%; height: auto; margin-top: 24px; user-select: none; }
  .wordmark text { font-family: var(--sans); font-weight: 900; font-size: 200px; fill: var(--paper); letter-spacing: -0.05em; }

  .bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 18px; margin-top: 16px; border-top: 1px solid rgba(244, 241, 251, .2); color: rgba(244, 241, 251, .5); }

  .wa-float {
    position: fixed; right: 20px; bottom: 20px; z-index: 40;
    width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center;
    background: #25d366; color: #fff; border: 2px solid var(--ink);
    transition: transform .3s var(--ease);
  }
  .wa-float:hover { transform: scale(1.08) rotate(-8deg); }

  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr 1fr; }
    .about { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .bottom { flex-direction: column; gap: 4px; }
    .clock { font-size: 36px; }
  }
</style>
