---
import { Image } from 'astro:assets';
import icono from '../assets/icono.png';
import { nav, site, waLink } from '../data/site';
const year = new Date().getFullYear();
---

<footer>
  <div class="container top">
    <div class="about">
      <a href="#inicio" class="brand">
        <Image src={icono} alt="" width={44} height={44} />
        <span>MordWave</span>
      </a>
      <p>Landing pages y webs con reservas para negocios que quieren crecer en digital.</p>
    </div>
    <div>
      <h4>Navegación</h4>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h4>Contacto</h4>
      <ul>
        <li><a href={waLink()} target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener">@{site.instagram}</a></li>
      </ul>
    </div>
  </div>
  <div class="container bottom">
    <p>© {year} MordWave. Todos los derechos reservados.</p>
    <p class="mono">Desarrollo web · Digital — Chillán, Chile</p>
  </div>
</footer>

<a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-1 1.2-.4.2-.7.1a8.2 8.2 0 0 1-4.1-3.6c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.4 3.4 0 0 0-1 2.5 5.9 5.9 0 0 0 1.2 3.1 13.5 13.5 0 0 0 5.2 4.6c1.9.8 2.7.9 3.6.7a3.1 3.1 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.2-.3-.3-.6-.4ZM12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8Zm8.4-18.2A11.8 11.8 0 0 0 1.8 17.8L.1 24l6.4-1.7A11.8 11.8 0 0 0 12 23.7 11.8 11.8 0 0 0 20.4 3.6Z"/></svg>
</a>

<style>
  footer { border-top: 1px solid var(--line); padding: 64px 0 28px; margin-top: 40px; }
  .top { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 40px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 22px; letter-spacing: -0.02em; }
  .brand img { width: 44px; height: 44px; }
  .about p { color: var(--muted); margin-top: 14px; max-width: 340px; font-size: 15px; }
  h4 { font-family: var(--mono); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); font-weight: 500; margin-bottom: 14px; }
  ul { list-style: none; display: grid; gap: 8px; font-size: 15px; }
  ul a { color: var(--text); opacity: .85; }
  ul a:hover { color: var(--lavender); opacity: 1; }
  .bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 48px; padding-top: 22px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  .mono { font-family: var(--mono); }

  .wa-float {
    position: fixed; right: 20px; bottom: 20px; z-index: 40;
    width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center;
    background: #25d366; color: #fff; box-shadow: 0 10px 30px -6px rgba(37, 211, 102, .6);
    transition: transform .2s;
  }
  .wa-float:hover { transform: scale(1.08); }

  @media (max-width: 760px) {
    .top { grid-template-columns: 1fr 1fr; }
    .about { grid-column: 1 / -1; }
  }
</style>
