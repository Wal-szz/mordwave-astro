---
import { Image } from 'astro:assets';
import icono from '../assets/icono.png';
import { nav, site, waLink } from '../data/site';
const year = new Date().getFullYear();

const socials = [
  {
    label: 'WhatsApp',
    href: waLink(),
    icon: '<path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.6-5.2A8.5 8.5 0 1 1 21 11.5Z"/>',
  },
  {
    label: 'Instagram',
    href: `https://instagram.com/${site.instagram}`,
    icon: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/>',
  },
  {
    label: 'Email',
    href: `mailto:${site.email}`,
    icon: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/>',
  },
];
---

<footer>
  <div class="container">

    <div class="top">
      <div class="about">
        <a href="#inicio" class="brand">
          <Image src={icono} alt="" width={44} height={44} />
          <span>MordWave</span>
        </a>
        <p>Landing pages y webs con reservas para negocios que quieren crecer en digital.</p>
        <div class="socials">
          {socials.map((s) => (
            <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener" aria-label={s.label}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
            </a>
          ))}
        </div>
      </div>
      <div>
        <h4>Navegación</h4>
        <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </div>
      <div>
        <h4>Contacto</h4>
        <ul>
          <li><a href={waLink()} target="_blank" rel="noopener">+56 9 8396 0591</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener">@{site.instagram}</a></li>
          <li class="loc">{site.location}</li>
        </ul>
      </div>
    </div>

    <!-- Marca grande: un SVG que siempre calza con el ancho disponible -->
    <svg class="wordmark" viewBox="0 0 1000 190" role="img" aria-label="MordWave">
      <defs>
        <linearGradient id="wm-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#d8d0ff" stop-opacity=".34" />
          <stop offset=".75" stop-color="#9d86ff" stop-opacity=".08" />
          <stop offset="1" stop-color="#9d86ff" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="wm-shine" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#fff" stop-opacity="0" />
          <stop offset=".5" stop-color="#fff" stop-opacity=".55" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
          <animate attributeName="x1" values="-1;1" dur="6s" repeatCount="indefinite" />
          <animate attributeName="x2" values="0;2" dur="6s" repeatCount="indefinite" />
        </linearGradient>
        <linearGradient id="wm-fade" x1="0" y1="0" x2="0" y2="1">
          <stop offset=".1" stop-color="#fff" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
        <mask id="wm-mask"><rect width="1000" height="190" fill="url(#wm-fade)" /></mask>
      </defs>
      <text x="500" y="160" text-anchor="middle" textLength="990" lengthAdjust="spacingAndGlyphs" fill="url(#wm-fill)">MordWave</text>
      <text x="500" y="160" text-anchor="middle" textLength="990" lengthAdjust="spacingAndGlyphs" fill="none" stroke="url(#wm-shine)" stroke-width="1.2" mask="url(#wm-mask)">MordWave</text>
    </svg>

    <div class="bottom">
      <p>© {year} MordWave. Todos los derechos reservados.</p>
      <p class="mono">Hecho en Chillán, Chile</p>
      <a href="#inicio" class="to-top">Volver arriba <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<a class="wa-float" id="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Cotizar por WhatsApp">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-1 1.2-.4.2-.7.1a8.2 8.2 0 0 1-4.1-3.6c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.4 3.4 0 0 0-1 2.5 5.9 5.9 0 0 0 1.2 3.1 13.5 13.5 0 0 0 5.2 4.6c1.9.8 2.7.9 3.6.7a3.1 3.1 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.2-.3-.3-.6-.4ZM12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8Zm8.4-18.2A11.8 11.8 0 0 0 1.8 17.8L.1 24l6.4-1.7A11.8 11.8 0 0 0 12 23.7 11.8 11.8 0 0 0 20.4 3.6Z"/></svg>
  <span>Cotizar</span>
</a>

<script>
  // El botón se esconde en el inicio, en Contacto y en el footer, donde ya hay botones de WhatsApp.
  const btn = document.getElementById('wa-float')!;
  const zones = ['inicio', 'contacto'].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  const footer = document.querySelector('footer');
  if (footer) zones.push(footer);
  const visible = new Set<Element>();
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
    btn.classList.toggle('hide', visible.size > 0);
  }, { threshold: 0.25 });
  zones.forEach((z) => io.observe(z));
</script>

<style>
  footer { border-top: 1px solid var(--line); padding: 80px 0 32px; margin-top: 40px; position: relative; overflow: hidden; }
  footer::before {
    content: ''; position: absolute; left: 50%; bottom: -30%; width: 90%; height: 70%; translate: -50% 0; pointer-events: none;
    background: radial-gradient(closest-side, rgba(123, 92, 255, .22), transparent); filter: blur(30px);
  }

  .top { display: grid; grid-template-columns: 1.6fr 1fr 1.2fr; gap: 40px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 22px; letter-spacing: -0.03em; }
  .brand img { width: 44px; height: 44px; }
  .about p { color: var(--muted); margin-top: 14px; max-width: 340px; font-size: 15px; }
  .socials { display: flex; gap: 10px; margin: 22px 0 8px; }
  .socials a {
    width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; color: var(--lavender);
    border: 1px solid var(--line-2); background: rgba(255,255,255,.03);
    transition: transform .4s var(--ease), background .3s, border-color .3s;
  }
  .socials a:hover { transform: translateY(-3px); background: rgba(123, 92, 255, .22); border-color: rgba(157, 134, 255, .5); }
  h4 { font-family: var(--mono); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); font-weight: 500; margin-bottom: 16px; }
  ul { list-style: none; display: grid; gap: 9px; font-size: 15px; }
  ul a { color: var(--text); opacity: .85; transition: color .3s, opacity .3s; word-break: break-word; }
  ul a:hover { color: var(--lavender); opacity: 1; }
  .loc { color: var(--muted); font-size: 14px; }

  .wordmark { display: block; width: 100%; height: auto; margin-top: 64px; user-select: none; }
  .wordmark text { font-family: var(--display); font-weight: 800; font-size: 200px; letter-spacing: -0.04em; }

  .bottom {
    display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;
    margin-top: 12px; padding-top: 22px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted);
  }
  .mono { font-family: var(--mono); }
  .to-top { display: inline-flex; gap: 8px; align-items: center; color: var(--lavender); transition: gap .3s var(--ease); }
  .to-top:hover { gap: 12px; }

  .wa-float {
    position: fixed; right: 20px; bottom: calc(20px + env(safe-area-inset-bottom, 0px)); z-index: 40;
    display: inline-flex; align-items: center; gap: 8px; height: 50px; padding: 0 20px 0 16px; border-radius: 999px;
    background: #25d366; color: #fff; font-weight: 700; font-size: 15px;
    box-shadow: 0 10px 24px -8px rgba(0, 0, 0, .6);
    transition: transform .45s var(--ease), opacity .3s;
  }
  .wa-float:hover { transform: translateY(-2px); }
  .wa-float.hide { opacity: 0; transform: translateY(16px); pointer-events: none; }

  @media (max-width: 720px) {
    .wa-float { right: 14px; bottom: calc(14px + env(safe-area-inset-bottom, 0px)); height: 46px; padding: 0 18px 0 14px; font-size: 14px; }
  }
  @media (max-width: 860px) {
    .top { grid-template-columns: 1fr 1fr; }
    .about { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    footer { padding-top: 64px; padding-bottom: 96px; }
    .top { grid-template-columns: 1fr; gap: 32px; }
    .wordmark { margin-top: 44px; }
    .bottom { flex-direction: column; align-items: flex-start; gap: 8px; }
  }
</style>
