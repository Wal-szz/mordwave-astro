---
// Solo dudas que no se responden en otras secciones (el pago y las reuniones están en "Cómo trabajamos").
const faqs = [
  {
    q: '¿Cuánto cuesta una página web?',
    a: 'Depende de lo que necesite tu negocio: no trabajamos con paquetes cerrados. En la reunión de inicio vemos el alcance y tu presupuesto, y te damos un precio cerrado antes de comenzar.',
  },
  {
    q: '¿Cuánto demora un proyecto?',
    a: 'Depende del tipo de web y de lo que necesites. En la reunión de inicio te damos una fecha de entrega, que empieza a correr cuando recibimos tus textos, fotos y logo.',
  },
  {
    q: '¿Quién compra el dominio?',
    a: 'Tú. Así el dominio (por ejemplo tunegocio.cl) queda a tu nombre y es tuyo. Te asesoramos para elegir uno y comprarlo.',
  },
  {
    q: '¿Cómo funcionan las reservas con Google Calendar?',
    a: 'Tus clientes eligen un día y una hora disponibles desde la web, y la cita aparece automáticamente en tu Google Calendar. También se puede pedir un abono para confirmar la hora.',
  },
  {
    q: '¿Puedo hacer cambios después de publicar?',
    a: 'Sí. Si necesitas actualizar textos o fotos, sumar secciones o nuevas funciones, nos escribes y lo vemos según el cambio.',
  },
  {
    q: '¿Trabajan con clientes de todo Chile?',
    a: 'Sí. Estamos en Chillán, Ñuble, y hacemos las reuniones por videollamada con negocios de todo el país.',
  },
];
---

<section id="faq">
  <div class="container grid">
    <div class="section-head reveal">
      <span class="eyebrow">Preguntas frecuentes</span>
      <h2 class="section-title">Antes de <span class="grad">comenzar.</span></h2>
      <p class="section-lead">Si tienes otra duda, escríbenos y te respondemos en menos de 24 horas.</p>
    </div>

    <div class="list">
      {faqs.map((f, i) => (
        <details open={i === 0} class="reveal" style={`--d:${i * 60}ms`}>
          <summary>
            <span>{f.q}</span>
            <i aria-hidden="true"></i>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; align-items: start; }
  .section-head { position: sticky; top: 110px; }
  .list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); interpolate-size: allow-keywords; }
  /* Apertura suave (navegadores modernos) */
  details::details-content { height: 0; overflow: hidden; transition: height .45s var(--ease), content-visibility .45s allow-discrete; }
  details[open]::details-content { height: auto; }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px;
    padding: 22px 0; font-size: 18px; font-weight: 600; letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker { display: none; }
  summary span { transition: color .3s, transform .4s var(--ease); }
  summary:hover span { color: var(--lavender); transform: translateX(6px); }
  i {
    flex: none; position: relative; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--line);
    transition: transform .3s, background .3s;
  }
  i::before, i::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; border-radius: 2px;
    background: var(--lavender); translate: -50% -50%;
  }
  i::after { rotate: 90deg; transition: rotate .3s; }
  details[open] i { background: var(--violet); border-color: var(--violet); }
  details[open] i::after { rotate: 0deg; }
  details p { color: var(--muted); padding: 0 48px 24px 0; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; gap: 0; }
    .section-head { position: static; }
    summary { font-size: 17px; }
    details p { padding-right: 0; }
  }
</style>
