---
import { waLink } from '../data/site';

const services = [
  {
    n: '01',
    t: 'Landing page a medida',
    d: 'Una página rápida y pensada para convertir visitas en clientes. Ideal para lanzar tu negocio, un servicio o una campaña.',
    tags: ['Diseño a medida', 'Responsive', 'WhatsApp', 'Formulario', 'SEO básico'],
  },
  {
    n: '02',
    t: 'Landing + reservas con Google Calendar',
    d: 'Tus clientes eligen día y hora desde la web y la cita llega directo a tu Google Calendar. Para estudios de tatuajes, barberías, estética y consultas.',
    tags: ['Agenda online', 'Google Calendar', 'Abono para confirmar', 'Confirmación'],
  },
];

const days = Array.from({ length: 14 }, (_, i) => i + 10);
const slots = ['10:00', '11:30', '15:00', '17:30'];
const flow = [
  { t: 'Elige el día', d: 'Ve solo los días con horas disponibles.' },
  { t: 'Elige la hora', d: 'Las horas tomadas no aparecen.' },
  { t: 'Confirma', d: 'Con abono, si lo necesitas.' },
  { t: 'Llega a tu calendario', d: 'La cita aparece sola en Google Calendar.' },
];
---

<section id="servicios" class="services">
  <div class="container">
    <div class="sec-head mono">
      <span class="idx">(02)</span>
      <span class="name">Servicios</span>
      <span class="count">Lo que hacemos</span>
    </div>

    <h2 class="display sec-title lines">
      <span><span style="--l:0">Dos cosas,</span></span>
      <span><span style="--l:1" class="ital">muy bien hechas.</span></span>
    </h2>

    <!-- Índice de servicios -->
    <ol class="index">
      {services.map((s) => (
        <li class="row reveal">
          <span class="n mono">{s.n}</span>
          <h3>{s.t}</h3>
          <div class="body">
            <p>{s.d}</p>
            <ul class="tags">{s.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
          <span class="price mono">Precio a tu medida</span>
        </li>
      ))}
    </ol>

    <!-- Cómo funciona una reserva: el celular y los pasos van sincronizados (ciclo de 10s) -->
    <div class="demo">
      <div class="demo-text reveal">
        <p class="mono kicker">Fig. 01 — Así reserva tu cliente</p>
        <ol class="flow">
          {flow.map((f, i) => (
            <li style={`--s:${i}`}>
              <span class="fn">{i + 1}</span>
              <div><strong>{f.t}</strong><span>{f.d}</span></div>
            </li>
          ))}
        </ol>
      </div>

      <div class="phone-wrap reveal" style="--d:120ms" aria-hidden="true">
        <div class="phone">
          <div class="notch"></div>
          <div class="screen">
            <p class="p-title">Reserva tu hora</p>
            <p class="p-month">Noviembre</p>
            <div class="week">{['L', 'M', 'M', 'J', 'V', 'S', 'D'].map((d) => <span>{d}</span>)}</div>
            <div class="days">
              {days.map((d) => (
                <span class:list={['day', { off: d % 7 === 2 || d === 10 || d === 11, sel: d === 14 }]}>{d}</span>
              ))}
            </div>
            <p class="p-label">Horarios</p>
            <div class="slots">
              {slots.map((s) => <span class:list={['slot', { sel: s === '15:00', off: s === '11:30' }]}>{s}</span>)}
            </div>
            <span class="confirm">Confirmar reserva</span>
            <div class="toast">
              <span class="t-ok">✓</span>
              <div><strong>¡Reserva confirmada!</strong><small>Añadida a Google Calendar</small></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Nos adaptamos a ti -->
    <div class="adapt reveal">
      <p class="statement">
        No vendemos paquetes. <span class="ital">Nos adaptamos a ti</span> — a lo que necesita tu negocio y a tu presupuesto.
      </p>
      <a class="btn" href={waLink('Hola MordWave, quiero cotizar una web a mi medida.')} target="_blank" rel="noopener">Cotizar sin compromiso <span class="arrow">→</span></a>
    </div>
  </div>
</section>

<style>
  .services { padding: 120px 0 0; }

  /* ---- Índice ---- */
  .index { list-style: none; border-top: 1px solid var(--line-strong); }
  .row {
    position: relative; display: grid; grid-template-columns: 80px 5fr 5fr 2fr; gap: 24px; align-items: start;
    padding: 36px 0; border-bottom: 1px solid var(--line-strong); isolation: isolate;
  }
  .row::before {
    content: ''; position: absolute; inset: 0; z-index: -1; background: var(--paper-2);
    transform: scaleY(0); transform-origin: bottom; transition: transform .5s var(--ease);
  }
  .row:hover::before { transform: scaleY(1); }
  .row .n { padding-top: 10px; color: var(--violet); }
  h3 { font-size: clamp(28px, 3.2vw, 44px); line-height: 1; letter-spacing: -0.045em; font-weight: 700; transition: transform .5s var(--ease); }
  .row:hover h3 { transform: translateX(8px); }
  .body p { color: var(--ink-2); max-width: 44ch; }
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .tags li { font-family: var(--mono); font-size: 11px; letter-spacing: .04em; padding: 5px 9px; border: 1px solid var(--line); }
  .price { justify-self: end; padding-top: 10px; color: var(--muted); }

  /* ---- Demo de reserva ---- */
  .demo { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; padding: 100px 0; }
  .kicker { color: var(--muted); margin-bottom: 28px; }
  .flow { list-style: none; border-top: 1px solid var(--line); }
  .flow li {
    display: grid; grid-template-columns: 56px 1fr; gap: 16px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--line);
    animation-duration: 10s; animation-iteration-count: infinite;
  }
  .flow li:nth-child(1) { animation-name: s1; }
  .flow li:nth-child(2) { animation-name: s2; }
  .flow li:nth-child(3) { animation-name: s3; }
  .flow li:nth-child(4) { animation-name: s4; }
  .fn {
    width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--ink);
    font-family: var(--serif); font-style: italic; font-size: 24px; transition: background .3s, color .3s;
  }
  .flow strong { display: block; font-size: 22px; letter-spacing: -0.03em; }
  .flow span:not(.fn) { color: var(--muted); font-size: 15px; }
  /* Cada paso se marca justo cuando el celular lo muestra */
  @keyframes s1 { 0%, 10% { opacity: .4; } 12%, 30% { opacity: 1; } 33%, 100% { opacity: .4; } }
  @keyframes s2 { 0%, 30% { opacity: .4; } 33%, 46% { opacity: 1; } 49%, 100% { opacity: .4; } }
  @keyframes s3 { 0%, 46% { opacity: .4; } 49%, 58% { opacity: 1; } 61%, 100% { opacity: .4; } }
  @keyframes s4 { 0%, 58% { opacity: .4; } 61%, 92% { opacity: 1; } 96%, 100% { opacity: .4; } }

  .phone-wrap { display: grid; place-items: center; position: relative; padding: 40px 0; }
  .phone-wrap::before {
    content: ''; position: absolute; inset: 0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px; mask-image: radial-gradient(circle, #000 30%, transparent 70%);
  }
  .phone { position: relative; width: 270px; border-radius: 40px; padding: 10px; background: var(--ink); }
  .notch { position: absolute; top: 18px; left: 50%; translate: -50% 0; width: 76px; height: 20px; border-radius: 999px; background: var(--ink); z-index: 2; }
  .screen { position: relative; border-radius: 31px; background: #fff; color: var(--ink); padding: 50px 18px 20px; overflow: hidden; font-size: 12px; }
  .p-title { font-weight: 800; font-size: 19px; letter-spacing: -0.03em; }
  .p-month { color: var(--muted); font-size: 12px; margin-bottom: 10px; font-family: var(--serif); font-style: italic; font-size: 16px; }
  .week, .days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; text-align: center; }
  .week span { font-size: 10px; color: var(--muted); font-weight: 600; }
  .days { margin-top: 4px; }
  .day { aspect-ratio: 1; display: grid; place-items: center; font-weight: 600; font-size: 11px; border: 1px solid var(--line); }
  .day.off { border-color: transparent; color: #c5c0d8; text-decoration: line-through; }
  .day.sel { animation: pickDay 10s var(--ease) infinite; }
  .p-label { margin: 14px 0 6px; font-weight: 700; font-size: 12px; }
  .slots { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .slot { text-align: center; padding: 7px 0; border: 1px solid var(--line); font-weight: 600; font-size: 11px; }
  .slot.off { color: #c5c0d8; text-decoration: line-through; }
  .slot.sel { animation: pickSlot 10s var(--ease) infinite; }
  .confirm { display: block; margin-top: 14px; text-align: center; padding: 11px 0; font-weight: 700; color: #fff; background: #b9b3cf; animation: confirm 10s var(--ease) infinite; }
  .toast {
    position: absolute; left: 10px; right: 10px; bottom: 12px; display: flex; gap: 10px; align-items: center;
    padding: 12px; background: var(--ink); color: #fff; animation: toast 10s var(--ease) infinite;
  }
  .toast strong { display: block; font-size: 12px; }
  .toast small { font-size: 10.5px; color: var(--violet-soft); }
  .t-ok { width: 26px; height: 26px; flex: none; display: grid; place-items: center; background: var(--green); color: #fff; font-weight: 800; }
  @keyframes pickDay { 0%, 10% { background: transparent; color: inherit; } 14%, 92% { background: var(--violet); color: #fff; border-color: var(--violet); } 100% { background: transparent; color: inherit; } }
  @keyframes pickSlot { 0%, 30% { background: transparent; color: inherit; } 34%, 92% { background: var(--violet); color: #fff; border-color: var(--violet); } 100% { background: transparent; color: inherit; } }
  @keyframes confirm { 0%, 46% { background: #b9b3cf; transform: none; } 49% { background: var(--ink); } 52% { transform: scale(.95); } 55%, 92% { background: var(--ink); transform: none; } 100% { background: #b9b3cf; } }
  @keyframes toast { 0%, 58% { opacity: 0; transform: translateY(24px); } 63%, 90% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; transform: translateY(24px); } }

  /* ---- Nos adaptamos a ti ---- */
  .adapt {
    display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: end;
    padding: 56px 0 120px; border-top: 1px solid var(--line-strong);
  }
  .statement { font-size: clamp(30px, 4vw, 54px); line-height: 1.05; letter-spacing: -0.045em; font-weight: 700; max-width: 22ch; }
  .statement .ital { font-size: 1.1em; }

  @media (max-width: 1000px) {
    .row { grid-template-columns: 56px 1fr; }
    .row .body { grid-column: 2; }
    .price { grid-column: 2; justify-self: start; padding-top: 0; }
    .demo { grid-template-columns: 1fr; gap: 24px; padding: 72px 0; }
    .adapt { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .services { padding-top: 80px; }
    .row { grid-template-columns: 1fr; gap: 12px; padding: 28px 0; }
    .row .body, .price { grid-column: 1; }
    .row .n { padding: 0; }
    .flow strong { font-size: 19px; }
    .phone { width: 250px; }
    .adapt { padding-bottom: 80px; }
    .adapt .btn { justify-content: space-between; }
  }
</style>
