---
import { site, waLink } from '../data/site';

const options = ['Landing page', 'Sitio web', 'Reservas online', 'No estoy seguro'];

const waIcon =
  '<path d="M17.5 14.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-1 1.2-.4.2-.7.1a8.2 8.2 0 0 1-4.1-3.6c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.4 3.4 0 0 0-1 2.5 5.9 5.9 0 0 0 1.2 3.1 13.5 13.5 0 0 0 5.2 4.6c1.9.8 2.7.9 3.6.7a3.1 3.1 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.2-.3-.3-.6-.4ZM12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8Zm8.4-18.2A11.8 11.8 0 0 0 1.8 17.8L.1 24l6.4-1.7A11.8 11.8 0 0 0 12 23.7 11.8 11.8 0 0 0 20.4 3.6Z"/>';

const channels = [
  { label: 'WhatsApp', value: '+56 9 8396 0591', href: waLink(), fill: true, icon: waIcon },
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, icon: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/>' },
  { label: 'Instagram', value: `@${site.instagram}`, href: `https://instagram.com/${site.instagram}`, icon: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/>' },
];
---

<section id="contacto">
  <div class="container">
    <div class="wrap card reveal">
      <div class="info">
        <span class="eyebrow">Contacto</span>
        <h2 class="section-title">Hablemos de <span class="grad">tu proyecto.</span></h2>
        <p class="section-lead">Cuéntanos qué necesita tu negocio y agendamos la reunión de inicio.</p>
        <p class="status"><i aria-hidden="true"></i>Respondemos en menos de 24 horas</p>

        <ul class="channels">
          {channels.map((c) => (
            <li>
              <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                <span class="ico" aria-hidden="true">
                  {c.fill ? (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" set:html={c.icon} />
                  ) : (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
                  )}
                </span>
                <span class="txt"><small>{c.label}</small>{c.value}</span>
                <span class="go" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="loc">{site.location}</p>
      </div>

      <!-- El formulario arma un mensaje y lo abre en WhatsApp (no necesita servidor) -->
      <form class="form" id="contact-form" data-wa={site.whatsapp}>
        <div class="row">
          <label>
            <span class="lbl">Nombre</span>
            <input name="nombre" required autocomplete="name" placeholder="Tu nombre" />
          </label>
          <label>
            <span class="lbl">Negocio <span class="opt">(opcional)</span></span>
            <input name="negocio" placeholder="Ej: Estudio Luna" />
          </label>
        </div>

        <fieldset>
          <legend>¿Qué necesitas?</legend>
          <div class="choices">
            {options.map((o, i) => (
              <label class="choice">
                <input type="radio" name="servicio" value={o} required={i === 0} />
                <span>{o}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label>
          <span class="lbl">Cuéntanos brevemente <span class="opt">(opcional)</span></span>
          <textarea name="mensaje" rows="4" placeholder="¿A qué se dedica tu negocio y qué te gustaría lograr?"></textarea>
        </label>

        <button class="btn send" type="submit">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" set:html={waIcon} />
          Enviar por WhatsApp
        </button>
        <p class="form-note" id="form-note" role="status" aria-live="polite">Se abrirá WhatsApp con tu mensaje listo para enviar.</p>
      </form>
    </div>
  </div>
</section>

<style>
  .wrap {
    display: grid; grid-template-columns: 1fr 1.05fr; gap: 56px; padding: 56px; overflow: hidden;
    background: radial-gradient(70% 60% at 0% 0%, rgba(123, 92, 255, .2), transparent 70%), var(--surface);
  }
  .info .section-title { margin-top: 18px; }
  .status { display: inline-flex; align-items: center; gap: 10px; margin-top: 18px; font-size: 14px; color: var(--lavender); }
  .status i { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 0 rgba(62, 224, 143, .6); animation: live 2s ease-out infinite; }
  @keyframes live { to { box-shadow: 0 0 0 8px rgba(62, 224, 143, 0); } }

  /* Canales: lista vertical, cada fila con ícono, dato y flecha */
  .channels { list-style: none; display: grid; gap: 8px; margin-top: 20px; }
  .channels a {
    display: flex; align-items: center; gap: 14px; padding: 10px 14px; border-radius: 14px;
    border: 1px solid var(--line); background: rgba(255, 255, 255, .02); transition: border-color .3s;
  }
  .channels a:hover { border-color: var(--line-2); }
  .channels .ico { flex: none; width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; color: var(--lavender); background: rgba(123, 92, 255, .16); }
  .channels li:first-child .ico { color: #25d366; background: rgba(37, 211, 102, .14); }
  .channels .txt { flex: 1; min-width: 0; display: grid; font-size: 14.5px; overflow-wrap: anywhere; }
  .channels small { color: var(--muted); font-size: 11px; font-family: var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .channels .go { color: var(--muted); transition: transform .35s var(--ease), color .3s; }
  .channels a:hover .go { color: var(--lavender); transform: translate(2px, -2px); }
  .loc { margin-top: 14px; font-size: 13px; color: var(--muted); }

  /* Formulario */
  .form { display: grid; gap: 20px; align-content: start; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  label, fieldset { display: grid; gap: 8px; font-size: 14px; font-weight: 500; color: var(--lavender); border: 0; min-width: 0; }
  legend { margin-bottom: 8px; }
  .opt { color: var(--muted); font-weight: 400; }
  input:not([type='radio']), textarea {
    font: inherit; font-size: 16px; color: var(--text); width: 100%;
    background: var(--bg); border: 1px solid var(--line-2); border-radius: 12px; padding: 13px 14px;
    transition: border-color .2s, box-shadow .2s;
  }
  textarea { resize: vertical; }
  input:not([type='radio']):focus, textarea:focus { outline: none; border-color: var(--violet-2); box-shadow: 0 0 0 3px rgba(123, 92, 255, .25); }
  ::placeholder { color: rgba(164, 156, 201, .55); }
  input:user-invalid { border-color: #ff6b81; }

  .choices { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .choice { display: block; cursor: pointer; }
  .choice input { position: absolute; opacity: 0; pointer-events: none; }
  .choice span {
    display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 12px; font-size: 15px; color: var(--text);
    border: 1px solid var(--line-2); background: var(--bg); transition: border-color .2s, background .2s;
  }
  .choice span::before { content: ''; flex: none; width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--muted); transition: all .2s; }
  .choice:hover span { border-color: var(--violet-2); }
  .choice input:checked + span { border-color: var(--violet); background: rgba(123, 92, 255, .16); }
  .choice input:checked + span::before { border-color: var(--violet-2); background: var(--violet-2); box-shadow: inset 0 0 0 3px var(--bg); }
  .choice input:focus-visible + span { outline: 2px solid var(--lavender); outline-offset: 2px; }

  .send { width: 100%; margin-top: 4px; background: #25d366; color: #06301a; font-weight: 700; }
  .send:hover { background: #2fe072; }
  .form-note { font-size: 13px; color: var(--muted); text-align: center; transition: color .3s; }
  .form-note.ok { color: var(--green); }

  @media (max-width: 960px) {
    .wrap { grid-template-columns: 1fr; padding: 32px 20px; gap: 36px; }
  }
  @media (max-width: 520px) {
    .row, .choices { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;

  // Arma el mensaje con los datos del formulario
  const buildMessage = () => {
    const d = new FormData(form);
    const nombre = String(d.get('nombre') || '').trim();
    const negocio = String(d.get('negocio') || '').trim();
    const servicio = String(d.get('servicio') || '').trim();
    const mensaje = String(d.get('mensaje') || '').trim();
    return [
      `Hola MordWave, soy ${nombre || '…'}.`,
      negocio ? `Negocio: ${negocio}` : '',
      servicio ? `Me interesa: ${servicio}` : '',
      mensaje ? `\n${mensaje}` : '',
    ].filter(Boolean).join('\n');
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(buildMessage())}`, '_blank', 'noopener');
    const note = document.getElementById('form-note')!;
    note.textContent = '¡Listo! Revisa la pestaña de WhatsApp y presiona enviar. Te respondemos en menos de 24 horas.';
    note.classList.add('ok');
  });
</script>
