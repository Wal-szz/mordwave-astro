---
const steps = [
  { title: 'Reunión de inicio', tag: 'Reunión', text: 'Conversamos sobre tu negocio, lo que necesitas y cómo quieres que se vea. Salimos con una propuesta clara de alcance y precio.' },
  { title: 'Abono del 50%', tag: 'Pago 1', text: 'Con el abono del 50% reservamos tu proyecto en nuestra agenda y comenzamos a trabajar.' },
  { title: 'Diseñamos y desarrollamos', tag: 'Trabajo', text: 'Construimos tu web para celular y computador. Te mantenemos al tanto del avance durante todo el proceso.' },
  { title: 'Reunión de revisión', tag: 'Revisión', text: 'Antes de publicar, revisamos juntos la web completa y aplicamos las correcciones que pidas.' },
  { title: 'Tu dominio', tag: 'Asesoría', text: 'Compras tu dominio (por ejemplo tunegocio.cl) para que quede a tu nombre. Te asesoramos en qué comprar y dónde.' },
  { title: 'Publicación y saldo', tag: 'Pago 2', text: 'Pagas el 50% restante, publicamos tu web en tu dominio y te explicamos cómo funciona.' },
];
---

<section id="proceso" class="process">
  <div class="container">
    <div class="sec-head mono">
      <span class="idx">(03)</span>
      <span class="name">Cómo trabajamos</span>
      <span class="count">Seis pasos</span>
    </div>

    <div class="layout">
      <div class="side">
        <h2 class="display sec-title lines">
          <span><span style="--l:0">De la idea</span></span>
          <span><span style="--l:1">al lanzamiento,</span></span>
          <span><span style="--l:2" class="ital">sin sorpresas.</span></span>
        </h2>
        <dl class="facts reveal">
          <div>
            <dt class="mono">Reuniones</dt>
            <dd><strong>Todas las necesarias.</strong> Partimos con una reunión de inicio, revisamos juntos antes de publicar y nos juntamos las veces que haga falta entre medio.</dd>
          </div>
          <div>
            <dt class="mono">Pago</dt>
            <dd><strong><span class="ital">50%</span> al comenzar, <span class="ital">50%</span> al publicar.</strong> Pagas el saldo cuando ya revisaste la web y está lista.</dd>
          </div>
        </dl>
      </div>

      <ol class="steps" id="steps">
        {steps.map((s, i) => (
          <li class="step reveal">
            <span class="num">{i + 1}.</span>
            <div>
              <span class="tag mono">{s.tag}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .process { padding: 0 0 120px; }
  .layout { display: grid; grid-template-columns: 5fr 7fr; gap: 64px; align-items: start; }
  .side { position: sticky; top: 90px; }
  .sec-title { font-size: clamp(40px, 5.4vw, 80px); }

  .facts { display: grid; border-top: 1px solid var(--line-strong); }
  .facts > div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  dt { color: var(--muted); padding-top: 4px; }
  dd { color: var(--ink-2); font-size: 15px; }
  dd strong { display: block; color: var(--ink); font-size: 20px; letter-spacing: -0.03em; margin-bottom: 4px; }
  dd .ital { font-size: 1.15em; }

  .steps { list-style: none; border-top: 1px solid var(--line-strong); margin-top: 56px; }
  .step { display: grid; grid-template-columns: 110px 1fr; gap: 24px; padding: 32px 0; border-bottom: 1px solid var(--line); }
  .num {
    font-family: var(--serif); font-style: italic; font-size: 72px; line-height: .8; color: var(--paper-3);
    -webkit-text-stroke: 1px var(--ink); transition: color .6s var(--ease);
  }
  .step.active .num { color: var(--violet); -webkit-text-stroke-color: var(--violet); }
  .tag { color: var(--violet); }
  h3 { font-size: 30px; letter-spacing: -0.04em; line-height: 1.05; margin: 6px 0 8px; }
  .step p { color: var(--ink-2); max-width: 52ch; }

  @media (max-width: 1000px) {
    .layout { grid-template-columns: 1fr; gap: 0; }
    .side { position: static; }
  }
  @media (max-width: 640px) {
    .process { padding-bottom: 80px; }
    .facts > div { grid-template-columns: 1fr; gap: 4px; }
    .step { grid-template-columns: 56px 1fr; gap: 12px; padding: 24px 0; }
    .num { font-size: 48px; }
    h3 { font-size: 24px; }
  }
</style>

<script>
  // Los números se pintan de morado a medida que pasas por cada paso
  const steps = [...document.querySelectorAll<HTMLElement>('#steps .step')];
  let ticking = false;
  const update = () => {
    ticking = false;
    const mid = innerHeight * 0.6;
    for (const s of steps) s.classList.toggle('active', s.getBoundingClientRect().top < mid);
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  update();
</script>
