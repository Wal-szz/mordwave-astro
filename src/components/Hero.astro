---
import { Image } from 'astro:assets';
import icono from '../assets/icono.png';
import { waLink } from '../data/site';

const words = ['web funcionando.', 'agenda llena.', 'negocio online.'];
const ticker = ['Landing pages', 'Reservas online', 'Google Calendar', 'Diseño a medida', 'WhatsApp integrado', 'SEO básico', 'Responsive', 'Abono online'];
---

<section class="hero" id="inicio">
  <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="grid-bg" aria-hidden="true"></div>

  <div class="container grid">
    <!-- Panel izquierdo: logo grande animado -->
    <div class="logo-wrap">
      <div class="logo-panel" id="logo-panel">
        <canvas id="particles" aria-hidden="true"></canvas>
        <div class="stage" aria-hidden="true">
          <div class="layer l1"><div class="ring ring-1"></div></div>
          <div class="layer l2"><div class="ring ring-2"></div></div>
          <div class="layer l3">
            <div class="ring ring-3"><span class="dot"></span></div>
            <div class="ring ring-4"><span class="dot"></span></div>
          </div>
          <div class="halo"></div>
          <div class="layer l4">
            <Image src={icono} alt="" class="logo" width={560} height={560} loading="eager" />
          </div>
        </div>
        <p class="tag">Desarrollo web · Digital</p>
      </div>

      <div class="chip chip-a" aria-hidden="true">
        <span class="ok">✓</span>
        <div><strong>Reserva confirmada</strong><small>Mar 12 · 15:00</small></div>
      </div>
      <div class="chip chip-b" aria-hidden="true">
        <span class="cal">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
        </span>
        <div><strong>Google Calendar</strong><small>Sincronizado</small></div>
      </div>
    </div>

    <!-- Panel derecho: información -->
    <div class="info">
      <span class="eyebrow rise" style="--i:0">Estudio web · Chillán, Chile</span>
      <h1>
        <span class="line"><span class="rise" style="--i:1">Del primer boceto</span></span>
        <span class="line"><span class="rise" style="--i:2">a tu</span></span>
        <span class="line rotator rise" style="--i:3" aria-label={words[0]}>
          <span class="rot-track" aria-hidden="true">
            {[...words, words[0]].map((w) => <span class="grad">{w}</span>)}
          </span>
        </span>
      </h1>
      <p class="lead rise" style="--i:4">
        Creamos landing pages a medida y webs con reservas conectadas a Google Calendar, para emprendimientos y pymes
        que quieren verse profesionales y recibir clientes desde el primer día.
      </p>
      <div class="actions rise" style="--i:5">
        <a class="btn btn-primary magnetic" href={waLink()} target="_blank" rel="noopener">Cotizar mi proyecto <span class="arrow">↗</span></a>
        <a class="btn btn-ghost magnetic" href="#proyectos">Ver proyecto demo</a>
      </div>
      <ul class="facts rise" style="--i:6">
        <li><strong>Desde $100.000</strong><span>Landing profesional</span></li>
        <li><strong><span data-count="2">2</span> reuniones</strong><span>Inicio y entrega</span></li>
        <li><strong><span data-count="50" data-suffix="%">50%</span> / 50%</strong><span>Abono y saldo</span></li>
      </ul>
    </div>
  </div>

  <div class="ticker marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => ticker.map((t) => <span class="tick">{t}<i>✦</i></span>))}
    </div>
  </div>
</section>

<style>
  .hero { min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: 130px 0 0; overflow: hidden; }

  /* Fondo: auroras y grilla */
  .aurora { position: absolute; inset: 0; pointer-events: none; filter: blur(70px); opacity: .75; }
  .aurora span { position: absolute; border-radius: 50%; mix-blend-mode: screen; }
  .aurora span:nth-child(1) { width: 46vw; height: 46vw; left: -8vw; top: 4vh; background: #5b3df0; opacity: .5; animation: drift1 18s ease-in-out infinite; }
  .aurora span:nth-child(2) { width: 34vw; height: 34vw; right: -6vw; top: -10vh; background: #b04dff; opacity: .25; animation: drift2 22s ease-in-out infinite; }
  .aurora span:nth-child(3) { width: 30vw; height: 30vw; left: 35vw; bottom: -14vw; background: #3a2bd1; opacity: .35; animation: drift1 26s ease-in-out infinite reverse; }
  @keyframes drift1 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(6vw, 4vh) scale(1.15); } }
  @keyframes drift2 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-5vw, 8vh) scale(.9); } }
  .grid-bg {
    position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%);
    opacity: .5;
  }

  .grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 64px; align-items: center; position: relative; flex: 1; }

  /* ---- Panel del logo ---- */
  .logo-wrap { position: relative; animation: panelIn 1.4s var(--ease) both; }
  @keyframes panelIn { from { opacity: 0; transform: translateY(40px) scale(.94); } }
  .logo-panel {
    --px: 0; --py: 0;
    position: relative; aspect-ratio: 1; border-radius: 36px; overflow: hidden;
    border: 1px solid var(--line-2);
    background:
      radial-gradient(70% 70% at 50% 45%, rgba(123, 92, 255, .22), transparent 70%),
      linear-gradient(180deg, rgba(24, 20, 52, .92), rgba(11, 10, 22, .92));
    box-shadow: 0 40px 120px -40px rgba(123, 92, 255, .55), 0 0 0 1px rgba(255,255,255,.03) inset;
    display: grid; place-items: center;
    transform: perspective(1200px) rotateX(calc(var(--py) * -8deg)) rotateY(calc(var(--px) * 8deg));
    transition: transform .25s ease-out;
  }
  /* Borde con luz giratoria */
  .logo-panel::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none; z-index: 3;
    background: conic-gradient(from var(--a, 0deg), transparent 0 70%, rgba(196, 180, 255, .9) 82%, transparent 92%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    animation: border-spin 6s linear infinite;
  }
  @property --a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @keyframes border-spin { to { --a: 360deg; } }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }

  .stage { position: relative; width: 80%; aspect-ratio: 1; display: grid; place-items: center; }
  .layer { position: absolute; inset: 0; display: grid; place-items: center; transition: transform .25s ease-out; }
  .l1 { transform: translate(calc(var(--px) * -10px), calc(var(--py) * -10px)); }
  .l2 { transform: translate(calc(var(--px) * -18px), calc(var(--py) * -18px)); }
  .l3 { transform: translate(calc(var(--px) * 14px), calc(var(--py) * 14px)); }
  .l4 { transform: translate(calc(var(--px) * 28px), calc(var(--py) * 28px)); }
  .logo {
    width: 74%; height: auto;
    filter: drop-shadow(0 30px 60px rgba(123, 92, 255, .55));
    animation: float 6s ease-in-out infinite, enter 1.6s var(--ease) .2s both;
  }
  .halo {
    position: absolute; width: 58%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, rgba(123, 92, 255, .6), transparent 65%);
    filter: blur(24px); animation: pulse 4s ease-in-out infinite;
  }
  .ring { position: absolute; border-radius: 50%; border: 1px solid rgba(214, 206, 255, .14); }
  .ring-1 { inset: 2%; border-style: dashed; animation: spin 70s linear infinite; }
  .ring-2 { inset: 13%; border-color: rgba(157, 134, 255, .24); animation: spin 45s linear infinite reverse; }
  .ring-3 { inset: 0; border-color: transparent; animation: spin 13s linear infinite; }
  .ring-4 { inset: 20%; border-color: transparent; animation: spin 8s linear infinite reverse; }
  .dot { position: absolute; top: -6px; left: 50%; width: 12px; height: 12px; border-radius: 50%; background: var(--lavender); box-shadow: 0 0 20px 5px rgba(157, 134, 255, .85); }
  .ring-4 .dot { width: 8px; height: 8px; top: -4px; background: var(--pink); box-shadow: 0 0 16px 4px rgba(200, 107, 255, .8); }
  .tag { position: absolute; bottom: 26px; z-index: 2; font-family: var(--mono); font-size: 12px; letter-spacing: .34em; text-transform: uppercase; color: var(--muted); }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -16px; } }
  @keyframes pulse { 0%, 100% { opacity: .65; scale: 1; } 50% { opacity: 1; scale: 1.14; } }
  @keyframes enter { from { opacity: 0; transform: scale(.6) rotate(-14deg); filter: blur(10px) drop-shadow(0 30px 60px rgba(123, 92, 255, .55)); } }

  /* Chips flotantes */
  .chip {
    position: absolute; z-index: 4; display: flex; align-items: center; gap: 12px;
    padding: 12px 16px 12px 12px; border-radius: 16px;
    background: rgba(22, 19, 49, .78); border: 1px solid var(--line-2);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 20px 40px -16px rgba(0, 0, 0, .6);
    font-size: 13px; line-height: 1.25;
  }
  .chip strong { display: block; font-weight: 600; }
  .chip small { color: var(--muted); font-size: 12px; }
  .chip-a { right: -26px; top: 15%; animation: chipIn 1s var(--ease) 1s both, bob 5s ease-in-out 2s infinite; }
  .chip-b { left: -22px; bottom: 14%; animation: chipIn 1s var(--ease) 1.3s both, bob 6s ease-in-out 2.3s infinite reverse; }
  .ok, .cal { width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center; flex: none; }
  .ok { background: rgba(62, 224, 143, .16); color: var(--green); font-weight: 700; }
  .cal { background: rgba(123, 92, 255, .22); color: var(--lavender); }
  @keyframes chipIn { from { opacity: 0; transform: translateY(16px) scale(.9); } }
  @keyframes bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -10px; } }

  /* ---- Información ---- */
  h1 { font-size: clamp(44px, 6.4vw, 86px); line-height: .98; letter-spacing: -0.05em; font-weight: 800; margin: 22px 0 26px; }
  .line { display: block; overflow: hidden; padding-bottom: .06em; }
  .rise { display: inline-block; animation: rise 1.1s var(--ease) both; animation-delay: calc(var(--i) * 90ms + 250ms); }
  .line > .rise { display: block; }
  @keyframes rise { from { opacity: 0; transform: translateY(105%); filter: blur(8px); } }
  .eyebrow.rise, .lead.rise, .actions.rise, .facts.rise { animation-name: fadeUp; }
  .lead.rise, .facts.rise { display: block; }
  .eyebrow.rise { display: inline-flex; }
  .actions.rise { display: flex; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(24px); filter: blur(6px); } }

  .rotator { height: 1.04em; display: block; }
  .rot-track { display: flex; flex-direction: column; animation: rotate 9s var(--ease) infinite; animation-delay: 2s; }
  .rot-track span { display: block; height: 1.04em; white-space: nowrap; }
  @keyframes rotate {
    0%, 25% { transform: translateY(0); }
    33%, 58% { transform: translateY(-1.04em); }
    66%, 91% { transform: translateY(-2.08em); }
    100% { transform: translateY(-3.12em); }
  }

  .lead { color: var(--muted); font-size: 19px; max-width: 520px; }
  .actions { flex-wrap: wrap; gap: 12px; margin: 36px 0 44px; }
  .facts { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .facts li { padding: 18px 16px 0 0; display: flex; flex-direction: column; }
  .facts li + li { padding-left: 18px; border-left: 1px solid var(--line); }
  .facts strong { font-size: 19px; letter-spacing: -0.02em; }
  .facts span { font-size: 13px; color: var(--muted); }

  /* Cinta inferior */
  .ticker { margin-top: 90px; border-block: 1px solid var(--line); padding: 20px 0; background: rgba(123, 92, 255, .035); position: relative; }
  .tick { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font-size: 22px; font-weight: 700; letter-spacing: -0.02em; white-space: nowrap; color: rgba(243, 240, 255, .82); }
  .tick i { font-style: normal; color: var(--violet-2); font-size: 16px; }

  @media (max-width: 960px) {
    .grid { grid-template-columns: 1fr; gap: 48px; }
    .logo-wrap { max-width: 460px; width: 100%; margin: 0 auto; }
    .chip-a { right: -8px; }
    .chip-b { left: -8px; }
    .hero { padding-top: 104px; }
    .ticker { margin-top: 64px; }
  }
  @media (max-width: 520px) {
    .chip { padding: 9px 12px 9px 9px; font-size: 12px; }
    .chip small { font-size: 11px; }
    .ok, .cal { width: 26px; height: 26px; }
    .chip-a { right: -4px; top: 6%; }
    .chip-b { left: -4px; bottom: 19%; }
    .facts { grid-template-columns: 1fr; }
    .facts li, .facts li + li { padding: 14px 0; border-left: 0; border-bottom: 1px solid var(--line); flex-direction: row; justify-content: space-between; align-items: baseline; }
    .actions .btn { flex: 1 1 100%; }
    .tick { font-size: 18px; }
  }
</style>

<script>
  const panel = document.getElementById('logo-panel') as HTMLElement;
  const canvas = document.getElementById('particles') as HTMLCanvasElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Profundidad: el logo y los anillos se mueven según el mouse
  if (!reduce && matchMedia('(pointer: fine)').matches) {
    const hero = document.getElementById('inicio')!;
    hero.addEventListener('pointermove', (e) => {
      const r = panel.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / (r.width / 1.2)));
      const y = Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / (r.height / 1.2)));
      panel.style.setProperty('--px', x.toFixed(3));
      panel.style.setProperty('--py', y.toFixed(3));
    });
    hero.addEventListener('pointerleave', () => {
      panel.style.setProperty('--px', '0');
      panel.style.setProperty('--py', '0');
    });
  }

  // Partículas conectadas (constelación)
  const ctx = canvas.getContext('2d')!;
  let w = 0, h = 0, dpr = 1, raf = 0, visible = true;
  type P = { x: number; y: number; vx: number; vy: number; r: number };
  let pts: P[] = [];
  const mouse = { x: -999, y: -999 };

  const resize = () => {
    dpr = Math.min(devicePixelRatio || 1, 2);
    w = canvas.clientWidth; h = canvas.clientHeight;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = Math.round((w * h) / 9000);
    pts = Array.from({ length: n }, () => ({
      x: Math.random() * w, y: Math.random() * h,
      vx: (Math.random() - 0.5) * 0.25, vy: (Math.random() - 0.5) * 0.25,
      r: Math.random() * 1.4 + 0.4,
    }));
  };

  const draw = () => {
    ctx.clearRect(0, 0, w, h);
    for (const p of pts) {
      p.x += p.vx; p.y += p.vy;
      if (p.x < 0 || p.x > w) p.vx *= -1;
      if (p.y < 0 || p.y > h) p.vy *= -1;
      // Repulsión suave del mouse
      const dx = p.x - mouse.x, dy = p.y - mouse.y, d2 = dx * dx + dy * dy;
      if (d2 < 9000) { p.x += dx * 0.02; p.y += dy * 0.02; }
    }
    for (let i = 0; i < pts.length; i++) {
      const a = pts[i];
      for (let j = i + 1; j < pts.length; j++) {
        const b = pts[j];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (d < 90) {
          ctx.strokeStyle = `rgba(170, 150, 255, ${(1 - d / 90) * 0.28})`;
          ctx.lineWidth = 0.6;
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
        }
      }
      ctx.fillStyle = 'rgba(216, 208, 255, .75)';
      ctx.beginPath(); ctx.arc(a.x, a.y, a.r, 0, Math.PI * 2); ctx.fill();
    }
    if (!reduce && visible) raf = requestAnimationFrame(draw);
  };

  panel.addEventListener('pointermove', (e) => {
    const r = canvas.getBoundingClientRect();
    mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
  });
  panel.addEventListener('pointerleave', () => { mouse.x = mouse.y = -999; });

  resize();
  draw();
  new ResizeObserver(resize).observe(canvas);
  // Pausa la animación cuando no se ve, para ahorrar batería
  new IntersectionObserver(([e]) => {
    visible = e.isIntersecting;
    cancelAnimationFrame(raf);
    if (visible) draw();
  }).observe(canvas);
</script>
