---
import { Image } from 'astro:assets';
import icono from '../assets/icono.png';
import { waLink } from '../data/site';

const pillars = [
  { n: '01', t: 'Landing pages', d: 'Diseñadas a medida para tu negocio.' },
  { n: '02', t: 'Reservas online', d: 'Conectadas a tu Google Calendar.' },
  { n: '03', t: 'Nos adaptamos a ti', d: 'Sin paquetes cerrados.' },
];
const ticker = ['Landing pages', 'Reservas online', 'Google Calendar', 'Diseño a medida', 'WhatsApp integrado', 'SEO básico', 'Responsive'];
const month = new Intl.DateTimeFormat('es-CL', { month: 'long', year: 'numeric', timeZone: 'America/Santiago' }).format(new Date());
---

<section class="hero" id="inicio">
  <div class="container">
    <!-- Fila de datos tipo portada de revista -->
    <div class="meta mono">
      <span>(001)</span>
      <span>Estudio de diseño y desarrollo web</span>
      <span>Chillán, Chile — <span data-clock>--:--</span></span>
      <span class="status"><i></i>Agenda abierta · {month}</span>
    </div>

    <div class="stage">
      <h1 class="display lines">
        <span><span style="--l:0">Del primer</span></span>
        <span><span style="--l:1">boceto a tu web</span></span>
        <span><span style="--l:2" class="ital">funcionando.</span></span>
      </h1>

      <!-- El zorro con su órbita, dibujado con líneas finas -->
      <div class="emblem" aria-hidden="true">
        <svg class="orbits" viewBox="0 0 400 400">
          <circle cx="200" cy="200" r="196" />
          <circle cx="200" cy="200" r="150" class="dash" />
          <g class="spin"><circle cx="200" cy="4" r="5" class="dot" /></g>
          <g class="spin rev"><circle cx="200" cy="50" r="3.5" class="dot v" /></g>
        </svg>
        <Image src={icono} alt="" class="fox" width={420} height={420} loading="eager" />
        <span class="cap mono">Fig. 00 — MordWave</span>
      </div>
    </div>

    <div class="intro">
      <p class="lead reveal">
        Creamos landing pages a medida y webs con reservas conectadas a Google Calendar, para emprendimientos y pymes
        que quieren verse profesionales y recibir clientes desde el primer día.
      </p>
      <div class="actions reveal" style="--d:120ms">
        <a class="btn" href={waLink()} target="_blank" rel="noopener">Cotizar mi proyecto <span class="arrow">→</span></a>
        <a class="btn btn-line" href="#proyectos">Ver proyecto demo</a>
      </div>
    </div>

    <ol class="pillars">
      {pillars.map((p, i) => (
        <li class="reveal" style={`--d:${i * 90}ms`}>
          <span class="mono n">{p.n}</span>
          <strong>{p.t}</strong>
          <span class="d">{p.d}</span>
        </li>
      ))}
    </ol>
  </div>

  <div class="ticker marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => ticker.map((t) => <span class="tick">{t}<i>✳</i></span>))}
    </div>
  </div>
</section>

<style>
  .hero { padding-top: 68px; }

  .meta {
    display: grid; grid-template-columns: 1fr 2fr 2fr 2fr; gap: 24px;
    padding: 18px 0; border-bottom: 1px solid var(--line); color: var(--ink-2);
  }
  .status { display: inline-flex; align-items: center; gap: 8px; justify-self: end; }
  .status i { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 0 rgba(24, 160, 88, .5); animation: live 2s ease-out infinite; }
  @keyframes live { to { box-shadow: 0 0 0 8px rgba(24, 160, 88, 0); } }

  .stage { position: relative; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 32px; padding: 64px 0 48px; }
  h1 { font-size: clamp(54px, 9.6vw, 156px); line-height: .88; letter-spacing: -0.06em; max-width: none; }
  h1 .ital { font-size: 1.12em; letter-spacing: -0.03em; }

  .emblem { position: relative; width: clamp(200px, 24vw, 360px); aspect-ratio: 1; display: grid; place-items: center; }
  .orbits { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .orbits circle { fill: none; stroke: var(--ink); stroke-width: 1; }
  .orbits .dash { stroke-dasharray: 2 6; stroke: var(--muted); }
  .orbits .dot { fill: var(--ink); stroke: none; }
  .orbits .dot.v { fill: var(--violet); }
  .spin { transform-origin: 200px 200px; animation: spin 18s linear infinite; }
  .spin.rev { animation-duration: 11s; animation-direction: reverse; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .fox { width: 62%; height: auto; animation: bob 6s ease-in-out infinite; }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  .cap { position: absolute; bottom: -30px; left: 0; right: 0; text-align: center; color: var(--muted); font-size: 11px; }

  .intro { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; align-items: end; padding: 24px 0 56px; }
  .lead { grid-column: 1 / span 6; font-size: 20px; color: var(--ink-2); max-width: 46ch; }
  .actions { grid-column: 8 / span 5; display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }

  .pillars { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line-strong); }
  .pillars li { padding: 22px 24px 28px 0; display: grid; gap: 4px; }
  .pillars li + li { padding-left: 24px; border-left: 1px solid var(--line); }
  .pillars .n { color: var(--violet); }
  .pillars strong { font-size: 22px; letter-spacing: -0.03em; margin-top: 10px; }
  .pillars .d { color: var(--muted); font-size: 15px; }

  .ticker { background: var(--ink); color: var(--paper); padding: 16px 0; margin-top: 8px; }
  .tick { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; white-space: nowrap; font-family: var(--serif); font-style: italic; font-size: 30px; }
  .tick i { font-style: normal; font-size: 16px; color: var(--violet-soft); }

  @media (max-width: 1000px) {
    .meta { grid-template-columns: 1fr 1fr; row-gap: 6px; }
    .meta > span:nth-child(1) { display: none; }
    .status { justify-self: start; }
    .stage { grid-template-columns: 1fr; padding-top: 40px; }
    .emblem { position: absolute; right: -10px; top: 8px; width: 38vw; max-width: 260px; opacity: .95; z-index: -1; }
    .cap { display: none; }
    .lead { grid-column: 1 / -1; }
    .actions { grid-column: 1 / -1; justify-content: flex-start; }
  }
  @media (max-width: 640px) {
    .meta { grid-template-columns: 1fr; }
    .meta > span:nth-child(2) { display: none; }
    .stage { padding: 120px 0 28px; }
    .emblem { width: 150px; right: 0; top: 18px; }
    .lead { font-size: 18px; }
    .actions .btn { flex: 1 1 100%; justify-content: space-between; }
    .pillars { grid-template-columns: 1fr; }
    .pillars li, .pillars li + li { padding: 16px 0; border-left: 0; border-bottom: 1px solid var(--line); grid-template-columns: 34px 1fr; }
    .pillars strong { margin: 0; font-size: 19px; }
    .pillars .d { grid-column: 2; }
    .tick { font-size: 24px; }
  }
</style>
