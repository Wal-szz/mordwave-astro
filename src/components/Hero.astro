---
import { Image } from 'astro:assets';
import icono from '../assets/icono.png';
import { waLink } from '../data/site';
---

<section class="hero" id="inicio">
  <div class="glow" aria-hidden="true"></div>
  <div class="container grid">
    <!-- Panel izquierdo: logo grande animado -->
    <div class="logo-panel">
      <div class="stage" aria-hidden="true">
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
        <div class="ring ring-3"><span class="dot"></span></div>
        <div class="ring ring-4"><span class="dot"></span></div>
        <div class="halo"></div>
        <Image src={icono} alt="Logo MordWave" class="logo" width={520} height={520} loading="eager" />
      </div>
      <p class="tag">Desarrollo web · Digital</p>
    </div>

    <!-- Panel derecho: información -->
    <div class="info">
      <span class="eyebrow">Estudio web · Chillán, Chile</span>
      <h1>Del primer boceto a tu <em>web funcionando.</em></h1>
      <p class="lead">
        Creamos landing pages a medida y webs con reservas conectadas a Google Calendar, para emprendimientos y
        pymes que quieren verse profesionales y recibir clientes desde el primer día.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={waLink()} target="_blank" rel="noopener">Cotizar mi proyecto ↗</a>
        <a class="btn btn-ghost" href="#proyectos">Ver proyecto demo →</a>
      </div>
      <ul class="facts">
        <li><strong>Desde $100.000</strong><span>Landing profesional</span></li>
        <li><strong>2 reuniones</strong><span>Inicio y entrega</span></li>
        <li><strong>50% / 50%</strong><span>Abono y saldo</span></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero { min-height: 100vh; min-height: 100svh; display: flex; align-items: center; padding: 120px 0 80px; overflow: hidden; }
  .glow {
    position: absolute; inset: -20% -10% auto -10%; height: 90%;
    background:
      radial-gradient(40% 50% at 25% 45%, rgba(123, 92, 255, .32), transparent 70%),
      radial-gradient(35% 40% at 85% 20%, rgba(154, 130, 255, .14), transparent 70%);
    pointer-events: none;
  }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; position: relative; }

  /* ---- Logo animado ---- */
  .logo-panel {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 32px;
    background:
      radial-gradient(70% 70% at 50% 45%, rgba(123, 92, 255, .18), transparent 70%),
      linear-gradient(180deg, rgba(26, 22, 49, .9), rgba(15, 13, 28, .9));
    aspect-ratio: 1 / 1;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .logo-panel::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(214, 206, 255, .14) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(circle at 50% 50%, #000 30%, transparent 75%);
  }
  .stage { position: relative; width: 78%; aspect-ratio: 1; display: grid; place-items: center; }
  .logo {
    position: relative; z-index: 2; width: 78%; height: auto;
    filter: drop-shadow(0 30px 50px rgba(123, 92, 255, .45));
    animation: float 6s ease-in-out infinite, enter 1.2s cubic-bezier(.2,.8,.2,1) both;
  }
  .halo {
    position: absolute; width: 55%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, rgba(123, 92, 255, .55), transparent 65%);
    filter: blur(20px);
    animation: pulse 4s ease-in-out infinite;
  }
  .ring { position: absolute; border-radius: 50%; border: 1px solid rgba(214, 206, 255, .14); }
  .ring-1 { inset: 4%; border-style: dashed; animation: spin 60s linear infinite; }
  .ring-2 { inset: 14%; border-color: rgba(154, 130, 255, .22); animation: spin 40s linear infinite reverse; }
  .ring-3 { inset: 0; border-color: transparent; animation: spin 14s linear infinite; }
  .ring-4 { inset: 20%; border-color: transparent; animation: spin 9s linear infinite reverse; }
  .dot {
    position: absolute; top: -6px; left: 50%; width: 12px; height: 12px; border-radius: 50%;
    background: var(--lavender); box-shadow: 0 0 18px 4px rgba(154, 130, 255, .8);
  }
  .ring-4 .dot { width: 8px; height: 8px; top: -4px; background: var(--violet-2); }
  .tag {
    position: absolute; bottom: 26px;
    font-family: var(--mono); font-size: 12px; letter-spacing: .32em; text-transform: uppercase; color: var(--muted);
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -14px; } }
  @keyframes pulse { 0%, 100% { opacity: .7; scale: 1; } 50% { opacity: 1; scale: 1.12; } }
  @keyframes enter { from { opacity: 0; transform: scale(.7) rotate(-8deg); } to { opacity: 1; transform: none; } }

  /* ---- Información ---- */
  h1 {
    font-size: clamp(42px, 6vw, 76px); line-height: 1; letter-spacing: -0.04em; font-weight: 800;
    margin: 18px 0 22px; text-wrap: balance;
  }
  h1 em {
    font-style: normal;
    background: linear-gradient(90deg, var(--lavender), var(--violet-2) 60%, var(--violet));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .lead { color: var(--muted); font-size: 19px; max-width: 520px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 34px 0 40px; }
  .facts { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--line); }
  .facts li { padding: 18px 16px 0 0; display: flex; flex-direction: column; }
  .facts li + li { padding-left: 16px; border-left: 1px solid var(--line); }
  .facts strong { font-size: 18px; letter-spacing: -0.01em; }
  .facts span { font-size: 13px; color: var(--muted); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 40px; }
    .logo-panel { max-width: 460px; width: 100%; margin: 0 auto; }
    .hero { padding-top: 100px; }
  }
  @media (max-width: 480px) {
    .facts { grid-template-columns: 1fr; }
    .facts li, .facts li + li { padding: 14px 0; border-left: 0; border-bottom: 1px solid var(--line); flex-direction: row; justify-content: space-between; align-items: baseline; }
    .actions .btn { flex: 1 1 100%; }
  }
</style>
