---
// ⚠️ Revisar con el equipo: lo que incluye, los plazos y la lista de material son una propuesta inicial.
const includes = [
  { t: 'Diseño a medida', d: 'Hecho para tu marca, sin plantillas.' },
  { t: 'Adaptada al celular', d: 'Se ve bien en teléfono, tablet y computador.' },
  { t: 'WhatsApp y formulario', d: 'Tus clientes te contactan con un toque.' },
  { t: 'Lista para Google', d: 'SEO básico y vista previa al compartir el link.' },
  { t: 'Sitio seguro', d: 'Publicada con candado de seguridad (SSL).' },
  { t: 'Asesoría de dominio', d: 'Te ayudamos a elegir y comprar tunegocio.cl.' },
  { t: 'Capacitación', d: 'Al entregar te explicamos cómo funciona tu web.' },
  { t: 'Acompañamiento', d: 'Seguimos disponibles después de publicar.' },
];

const times = [
  { t: 'Landing page', v: '5 a 7', u: 'días hábiles' },
  { t: 'Landing + reservas', v: '7 a 10', u: 'días hábiles' },
  { t: 'Sitio web', v: '10 a 15', u: 'días hábiles' },
  { t: 'Tienda online', v: 'Pronto', u: 'te avisamos' },
];

const needs = [
  { t: 'Tu logo', d: 'Si no tienes, lo conversamos.' },
  { t: 'Textos de tu negocio', d: 'Qué haces y para quién. Si no los tienes, te ayudamos a escribirlos.' },
  { t: 'Fotos', d: 'De tus productos, trabajos o local.' },
  { t: 'Datos de contacto', d: 'WhatsApp, correo, dirección y redes.' },
  { t: 'Para reservas', d: 'Tus horarios y acceso a tu Google Calendar.' },
];
---

<section id="incluye" class="includes">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Qué incluye</span>
      <h2 class="section-title">Todo lo que tu web <span class="grad">necesita para partir.</span></h2>
      <p class="section-lead">Sin letra chica: esto viene en cada proyecto, sea landing, sitio web o reservas.</p>
    </div>

    <ul class="inc">
      {includes.map((x, i) => (
        <li class="reveal" style={`--d:${(i % 4) * 70}ms`}>
          <span class="tick" aria-hidden="true">✓</span>
          <div><strong>{x.t}</strong><span>{x.d}</span></div>
        </li>
      ))}
    </ul>

    <div class="split">
      <div class="card block reveal">
        <h3>Plazos estimados</h3>
        <p class="note">Desde que recibimos tu material. La fecha exacta te la damos en la reunión de inicio.</p>
        <dl class="times">
          {times.map((x) => (
            <div>
              <dt>{x.t}</dt>
              <dd><strong>{x.v}</strong> {x.u}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="card block reveal" style="--d:100ms">
        <h3>Qué necesitamos de ti</h3>
        <p class="note">Con esto partimos. Si te falta algo, no es problema: lo vemos juntos.</p>
        <ol class="needs">
          {needs.map((x) => (
            <li><strong>{x.t}</strong><span>{x.d}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .includes { padding-top: 0; }
  .inc { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .inc li { display: flex; gap: 14px; padding: 24px 22px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .tick { flex: none; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: 13px; font-weight: 800; color: #fff; background: var(--violet); }
  .inc strong { display: block; font-family: var(--display); font-size: 17px; letter-spacing: -0.01em; margin-bottom: 2px; }
  .inc span:not(.tick) { color: var(--muted); font-size: 14.5px; }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 40px; }
  .block { padding: 32px; }
  .block h3 { font-size: 24px; letter-spacing: -0.02em; }
  .note { color: var(--muted); font-size: 14.5px; margin: 6px 0 20px; }

  .times > div { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 14px 0; border-top: 1px solid var(--line); }
  .times dt { font-weight: 500; }
  .times dd { color: var(--muted); font-size: 14px; text-align: right; }
  .times strong { font-family: var(--display); color: var(--text); font-size: 22px; letter-spacing: -0.02em; margin-right: 4px; }

  .needs { list-style: none; counter-reset: n; display: grid; }
  .needs li { counter-increment: n; display: grid; grid-template-columns: 34px 1fr; padding: 12px 0; border-top: 1px solid var(--line); }
  .needs li::before { content: counter(n, decimal-leading-zero); font-family: var(--mono); font-size: 12px; color: var(--violet-2); padding-top: 3px; grid-row: span 2; }
  .needs strong { font-weight: 600; }
  .needs span { color: var(--muted); font-size: 14.5px; }

  @media (max-width: 1000px) {
    .inc { grid-template-columns: repeat(2, 1fr); }
    .split { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .inc { grid-template-columns: 1fr; }
    .inc li { padding: 18px 16px; }
    .block { padding: 24px 20px; }
  }
</style>
