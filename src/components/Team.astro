---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import icono from '../assets/icono.png';

// Fotos: guárdalas en src/assets/equipo/ (ej: walter.jpg) e impórtalas aquí, por ejemplo:
//   import walterFoto from '../assets/equipo/walter.jpg';
// y luego pon `photo: walterFoto` en la persona. Sin foto se muestra el ícono de MordWave.
type Member = { name: string; role?: string; studies: string; bio: string; photo?: ImageMetadata };

const team: Member[] = [
  {
    name: 'Walter Saez',
    role: 'Jefe de proyecto',
    studies: 'Ingeniero Informático · Desarrollo web',
    bio: 'Es tu contacto principal: lidera las reuniones, ordena los plazos y se asegura de que la web cumpla lo que tu negocio necesita.',
  },
  {
    name: 'Carlos Yáñez',
    role: 'Líder técnico',
    studies: 'Ingeniero Informático · Arquitectura y Desarrollo de Software',
    bio: 'Lidera las decisiones tecnológicas de MordWave, definiendo arquitecturas, herramientas y estándares de desarrollo para crear soluciones digitales seguras, escalables y de calidad.',
  },
  {
    name: 'Bastian Nuñez',
    // role: 'Cargo por definir',  ← cuando lo tengan, quita las // de esta línea y escribe el cargo
    studies: 'Ingeniero Informático · Desarrollo web',
    bio: 'Diseña y desarrolla las secciones de cada web para que se vean y funcionen bien en celular y computador.',
  },
];

const values = [
  { t: 'Trato directo', d: 'Hablas con quienes construyen tu web, sin intermediarios.' },
  { t: 'Desde Ñuble', d: 'Estamos en Chillán y trabajamos a distancia con todo Chile.' },
  { t: 'Acompañamiento', d: 'Te guiamos antes, durante y después de publicar.' },
];
---

<section id="equipo" class="team">
  <div class="container">
    <div class="sec-head mono">
      <span class="idx">(05)</span>
      <span class="name">Equipo de trabajo</span>
      <span class="count">Chillán, Ñuble</span>
    </div>

    <div class="intro">
      <h2 class="display sec-title lines">
        <span><span style="--l:0">Tres ingenieros</span></span>
        <span><span style="--l:1" class="ital">detrás de tu web.</span></span>
      </h2>
      <p class="sec-lead reveal">
        MordWave es un estudio de diseño y desarrollo web nacido en Ñuble. Somos ingenieros informáticos y preferimos
        pocos proyectos bien hechos a muchos a medias.
      </p>
    </div>

    <div class="people">
      {team.map((m, i) => (
        <article class="person reveal" style={`--d:${i * 100}ms`}>
          <div class="portrait">
            {m.photo ? (
              <Image src={m.photo} alt={`Foto de ${m.name}`} width={600} height={720} />
            ) : (
              <Image src={icono} alt="" width={240} height={240} class="ph" />
            )}
            <span class="mono pno">0{i + 1}</span>
          </div>
          <h3>{m.name}</h3>
          <p class="role mono">{m.role ?? 'Cargo próximamente'}</p>
          <p class="studies">{m.studies}</p>
          <p class="bio">{m.bio}</p>
        </article>
      ))}
    </div>

    <ul class="values">
      {values.map((v, i) => (
        <li class="reveal" style={`--d:${i * 90}ms`}>
          <span class="ital vn">{['i', 'ii', 'iii'][i]}.</span>
          <div><h4>{v.t}</h4><p>{v.d}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team { padding: 0 0 120px; }
  .intro { display: grid; grid-template-columns: 7fr 5fr; gap: 48px; align-items: end; }
  .intro .sec-lead { margin-bottom: 72px; }

  .people { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 56px; border-top: 1px solid var(--line-strong); }
  .person { position: relative; padding: 28px 0 36px; }
  .person + .person::before { content: ''; position: absolute; left: -28px; top: 0; bottom: 0; border-left: 1px solid var(--line); }
  .portrait {
    position: relative; aspect-ratio: 5 / 6; display: grid; place-items: center; overflow: hidden; margin-bottom: 22px;
    background:
      repeating-linear-gradient(135deg, transparent 0 10px, rgba(20, 17, 42, .045) 10px 11px),
      var(--paper-2);
    border: 1px solid var(--line);
  }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .portrait :global(.ph) { width: 44%; height: auto; object-fit: contain; transition: transform .8s var(--ease); }
  .person:hover .portrait :global(.ph) { transform: rotate(-10deg) scale(1.06); }
  .pno { position: absolute; top: 12px; left: 14px; color: var(--muted); }
  h3 { font-size: 30px; letter-spacing: -0.045em; line-height: 1; }
  .role { color: var(--violet); margin: 10px 0 6px; }
  .studies { font-size: 14px; color: var(--muted); margin-bottom: 14px; }
  .bio { color: var(--ink-2); font-size: 15.5px; }

  .values { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 28px; margin-top: 56px; border-top: 1px solid var(--line-strong); }
  .values li { display: grid; grid-template-columns: 44px 1fr; padding-top: 20px; }
  .vn { font-size: 26px; line-height: 1; }
  h4 { font-size: 18px; letter-spacing: -0.02em; }
  .values p { color: var(--muted); font-size: 15px; }

  @media (max-width: 1000px) {
    .intro { grid-template-columns: 1fr; gap: 0; }
    .intro .sec-lead { margin: -40px 0 48px; }
    .people { grid-template-columns: 1fr; }
    .person, .person + .person {
      display: grid; grid-template-columns: 120px 1fr; column-gap: 20px; padding: 24px 0; border-bottom: 1px solid var(--line);
    }
    .person + .person::before { display: none; }
    .portrait { grid-row: 1 / span 4; margin: 0; align-self: start; }
    .values { grid-template-columns: 1fr; }
    .values li { padding: 16px 0; border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 640px) {
    .team { padding-bottom: 80px; }
    .intro .sec-lead { margin: -20px 0 36px; }
    .person, .person + .person { grid-template-columns: 88px 1fr; column-gap: 16px; }
    h3 { font-size: 24px; }
  }
</style>
