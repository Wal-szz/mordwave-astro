---
import { Image } from 'astro:assets';
import demo from '../assets/demo-tattoo.jpg';


const demoUrl = 'https://landing-tatto-calendar.vercel.app';

---

<section id="proyectos">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Proyectos</span>
      <h2 class="section-title">Mira lo que podemos <span class="grad">construir para ti.</span></h2>
      <p class="section-lead">Un demo funcionando, para que veas cómo se siente una de nuestras webs antes de empezar.</p>
    </div>

    <article class="project card spot reveal">
      <div class="visual">
        <a class="shot" href={demoUrl} target="_blank" rel="noopener" aria-label="Abrir el demo en una pestaña nueva" data-tilt="6">
          <div class="browser">
            <span></span><span></span><span></span>
            <p>landing-tatto-calendar.vercel.app</p>
          </div>
          <div class="img">
            <Image src={demo} alt="Vista del demo: landing de un estudio de body modification" widths={[480, 800]} sizes="(max-width: 900px) 100vw, 640px" />
            <span class="open">Abrir demo ↗</span>
          </div>
        </a>
        <div class="float f1" aria-hidden="true"><span class="dot-live"></span>En vivo</div>
      </div>

      <div class="body">
        <span class="kind">Demo · Landing + reservas</span>
        <h3>Estudio de body modification</h3>
        <p>
          Landing oscura y elegante para un estudio de piercings y modificación corporal. Muestra materiales, galería y
          preguntas frecuentes, y permite reservar una cita desde la misma página.
        </p>
        <a class="btn btn-primary magnetic" href={demoUrl} target="_blank" rel="noopener">Ver demo en vivo <span class="arrow">↗</span></a>
      </div>
    </article>
  </div>
</section>

<style>
  .project { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); overflow: hidden; }
  .visual {
    position: relative; padding: 44px 0 44px 44px;
    background: radial-gradient(80% 80% at 30% 40%, rgba(123, 92, 255, .3), transparent 70%);
  }
  .shot { display: block; border-radius: 16px; overflow: hidden; border: 1px solid var(--line-2); box-shadow: 0 40px 80px -30px rgba(0,0,0,.8), 0 0 60px -20px rgba(123, 92, 255, .5); will-change: transform; }
  .browser { display: flex; align-items: center; gap: 6px; padding: 12px 14px; background: #1b1834; border-bottom: 1px solid var(--line); }
  .browser span { width: 10px; height: 10px; border-radius: 50%; background: rgba(214, 206, 255, .25); }
  .browser span:nth-child(1) { background: #ff6b81; }
  .browser span:nth-child(2) { background: #ffc35c; }
  .browser span:nth-child(3) { background: #3ee08f; }
  .browser p { margin-left: 10px; font-family: var(--mono); font-size: 12px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .img { position: relative; overflow: hidden; }
  .img :global(img) { width: 100%; transition: transform 1s var(--ease); }
  .shot:hover .img :global(img) { transform: scale(1.05); }
  .open {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; padding: 12px 20px; border-radius: 999px;
    background: var(--bg); border: 1px solid var(--line-2); font-weight: 600; font-size: 14px;
    opacity: 0; scale: .9; transition: opacity .4s, scale .4s var(--ease);
  }
  .shot:hover .open { opacity: 1; scale: 1; }

  .float {
    position: absolute; z-index: 2; padding: 10px 14px; border-radius: 14px; font-size: 13px;
    background: var(--surface); border: 1px solid var(--line-2);
    box-shadow: 0 16px 30px -12px rgba(0,0,0,.7); display: flex; align-items: center; gap: 8px;
  }
  .float strong { color: var(--lavender); }
  .f1 { top: 22px; left: 22px; animation: bob 5s ease-in-out infinite; }
  .dot-live { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 0 rgba(62, 224, 143, .7); animation: live 1.8s ease-out infinite; }
  @keyframes live { to { box-shadow: 0 0 0 9px rgba(62, 224, 143, 0); } }
  @keyframes bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -8px; } }

  .body { padding: 48px 44px; display: flex; flex-direction: column; justify-content: center; }
  .kind { font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--violet-2); }
  h3 { font-size: 34px; letter-spacing: -0.035em; line-height: 1.05; margin: 12px 0 14px; }
  .body p { color: var(--muted); }
  .body .btn { align-self: flex-start; margin-top: 28px; }

  /* ---- Más proyectos ---- */
  .more { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
  .mini { overflow: hidden; display: flex; flex-direction: column; }
  .mshot { display: block; overflow: hidden; border-bottom: 1px solid var(--line); aspect-ratio: 16 / 9; }
  .mshot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 1s var(--ease); }
  .mshot:hover :global(img) { transform: scale(1.04); }
  .mbody { padding: 26px 28px 28px; display: flex; flex-direction: column; flex: 1; }
  .mtop { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
  .mbadge { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; border: 1px dashed var(--line-2); color: var(--muted); }
  .mbadge.real { border: 0; background: rgba(62, 224, 143, .14); color: var(--green); }
  .mini h3 { font-size: 26px; margin: 12px 0 14px; }
  .mini dl { display: grid; gap: 10px; margin-bottom: 20px; }
  .mini dl > div { display: grid; grid-template-columns: 96px 1fr; gap: 12px; font-size: 15px; }
  .mini dt { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--violet-2); padding-top: 3px; }
  .mini dd { color: var(--muted); }
  .visit { margin-top: auto; align-self: flex-start; display: inline-flex; gap: 8px; font-weight: 600; color: var(--lavender); }
  .visit .arrow { transition: transform .35s var(--ease); }
  .visit:hover .arrow { transform: translate(3px, -3px); }

  @media (max-width: 900px) {
    .more { grid-template-columns: 1fr; }
    .mbody { padding: 22px 20px 24px; }
    .mini dl > div { grid-template-columns: 1fr; gap: 2px; }
    .project { grid-template-columns: minmax(0, 1fr); }
    .visual { padding: 56px 22px 22px; }
    .f1 { top: 14px; left: 22px; }
    .body { padding: 28px 22px 32px; }
    h3 { font-size: 28px; }
  }
</style>
