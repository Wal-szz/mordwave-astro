---
import { Image } from 'astro:assets';
import demo from '../assets/demo-tattoo.jpg';

const demoUrl = 'https://landing-tatto-calendar.vercel.app';
const meta = [
  ['Tipo', 'Landing + reservas'],
  ['Rubro', 'Body modification'],
  ['Incluye', 'Reserva de citas, abono del 50% para confirmar, galería, guía interactiva por zona, preguntas frecuentes'],
  ['Estado', 'Demo funcionando'],
];
---

<section id="proyectos" class="projects">
  <div class="container">
    <div class="sec-head mono">
      <span class="idx">(04)</span>
      <span class="name">Proyectos</span>
      <span class="count">Demo en vivo</span>
    </div>

    <h2 class="display sec-title lines">
      <span><span style="--l:0">Mira lo que podemos</span></span>
      <span><span style="--l:1" class="ital">construir para ti.</span></span>
    </h2>

    <article class="project">
      <figure class="reveal">
        <a class="shot" href={demoUrl} target="_blank" rel="noopener" aria-label="Abrir el demo en una pestaña nueva">
          <Image src={demo} alt="Vista del demo: landing de un estudio de body modification" widths={[480, 800]} sizes="(max-width: 1000px) 100vw, 760px" />
          <span class="open">Abrir demo <span aria-hidden="true">↗</span></span>
        </a>
        <figcaption class="mono">Fig. 02 — landing-tatto-calendar.vercel.app</figcaption>
      </figure>

      <div class="info reveal" style="--d:120ms">
        <span class="mono no">N.º 01</span>
        <h3>Estudio de body modification</h3>
        <p>
          Landing oscura y elegante para un estudio de piercings y modificación corporal, con reserva de citas y abono
          del 50% para confirmar la hora.
        </p>
        <dl>
          {meta.map(([k, v]) => (
            <div><dt class="mono">{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
        <a class="btn" href={demoUrl} target="_blank" rel="noopener">Ver demo en vivo <span class="arrow">↗</span></a>
      </div>
    </article>
  </div>
</section>

<style>
  .projects { padding: 0 0 120px; }
  .project { display: grid; grid-template-columns: 7fr 5fr; gap: 48px; align-items: start; }
  .shot { position: relative; display: block; overflow: hidden; border: 1px solid var(--ink); background: var(--ink); }
  .shot :global(img) { width: 100%; transition: transform 1.2s var(--ease), opacity .5s; }
  .shot:hover :global(img) { transform: scale(1.04); opacity: .85; }
  .open {
    position: absolute; right: 0; bottom: 0; padding: 14px 18px; background: var(--paper); color: var(--ink);
    font-weight: 600; font-size: 14px; border-left: 1px solid var(--ink); border-top: 1px solid var(--ink);
    transform: translateY(100%); transition: transform .5s var(--ease);
  }
  .shot:hover .open, .shot:focus-visible .open { transform: none; }
  figcaption { margin-top: 12px; color: var(--muted); }

  .no { color: var(--violet); }
  h3 { font-size: clamp(32px, 3.4vw, 48px); line-height: 1; letter-spacing: -0.045em; margin: 10px 0 16px; }
  .info > p { color: var(--ink-2); }
  dl { margin: 28px 0 32px; border-top: 1px solid var(--line-strong); }
  dl > div { display: grid; grid-template-columns: 90px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  dt { color: var(--muted); padding-top: 2px; }

  @media (max-width: 1000px) {
    .project { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 640px) {
    .projects { padding-bottom: 80px; }
    .info .btn { width: 100%; justify-content: space-between; }
    .open { transform: none; }
  }
</style>
